# =============================================================================
# GitHub Linguist — repositorio educativo GD32VW553
# Implementación actual: C + RISC-V Assembly
#
# Regla:
#   - Los lenguajes que forman parte REAL de la solución sí cuentan.
#   - Herramientas auxiliares (PowerShell, CMake, JSON, VS Code, documentación)
#     no alteran la barra de lenguajes.
# =============================================================================

# Código real de la solución
*.c linguist-language=C
*.h linguist-language=C
*.S linguist-language=Assembly
*.s linguist-language=Assembly

# Herramientas y automatización: necesarias, pero no son parte del algoritmo
*.ps1 linguist-detectable=false
*.bat linguist-detectable=false
*.cmd linguist-detectable=false
tools/** linguist-detectable=false

# CMake / configuración
CMakeLists.txt linguist-detectable=false
*.cmake linguist-detectable=false
CMakePresets.json linguist-detectable=false
*.json linguist-detectable=false
.vscode/** linguist-detectable=false

# Documentación
*.md linguist-documentation=true
Doc/** linguist-documentation=true

# Linker y artefactos generados
*.ld linguist-detectable=false
*.lds linguist-detectable=false
*.map linguist-generated=true
*.lst linguist-generated=true
*.hex linguist-generated=true
*.bin linguist-generated=true
